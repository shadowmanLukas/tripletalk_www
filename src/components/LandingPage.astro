---
import "../styles/global.css";
import {
  landingContent,
  landingSeo,
  type LandingLanguage,
} from "../lib/landing-content";
import LanguageTicker from "./LanguageTicker.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import StoreButtons from "./StoreButtons.astro";

interface Props {
  language: LandingLanguage;
}

const { language } = Astro.props;
const copy = landingContent[language];
const seo = landingSeo[language];
const guideHref = "/guide/";

// Simple stroke icons for the benefit cards (24px grid, drawn with currentColor).
const benefitIcons: Record<string, string> = {
  camera:
    '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',
  languages:
    '<rect x="3" y="5" width="11" height="9" rx="2"/><path d="M10 14v3a2 2 0 0 0 2 2h7a2 2 0 0 0 2-2v-5a2 2 0 0 0-2-2h-5"/><path d="M6 9.5h5M8.5 8v1.5"/>',
  headphones:
    '<path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/>',
  repeat:
    '<path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5"/><path d="M20 4v4.5h-4.5"/><path d="M20 12a8 8 0 0 1-13.7 5.6L4 15.5"/><path d="M4 20v-4.5h4.5"/>',
  voice:
    '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  collection:
    '<rect x="4" y="7" width="13" height="13" rx="2"/><path d="M8 4h10a2 2 0 0 1 2 2v10"/>',
};

const canonicalUrl =
  language === "pl" ? "https://tripletalk.app/" : "https://tripletalk.app/en/";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "TripleTalk AI",
    url: canonicalUrl,
    description: seo.description,
    applicationCategory: "EducationalApplication",
    operatingSystem: "iOS, Android",
    inLanguage: language,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
    },
    publisher: {
      "@id": "https://tripletalk.app/#organization",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://tripletalk.app/#organization",
    name: "TripleTalk",
    url: "https://tripletalk.app/",
    logo: {
      "@type": "ImageObject",
      url: "https://tripletalk.app/assets/tripletalk-logo-with-background.png",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://tripletalk.app/#website",
    name: "TripleTalk AI",
    url: "https://tripletalk.app/",
    inLanguage: ["pl", "en"],
    publisher: {
      "@id": "https://tripletalk.app/#organization",
    },
  },
];
---

<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={seo.description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TripleTalk" />
    <meta property="og:locale" content={seo.locale} />
    <meta
      property="og:locale:alternate"
      content={language === "pl" ? "en_US" : "pl_PL"}
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content="https://tripletalk.app/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TripleTalk AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content="https://tripletalk.app/og.png" />
    <meta name="twitter:image:alt" content="TripleTalk AI" />
    <title>{seo.title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pl" href="https://tripletalk.app/" />
    <link rel="alternate" hreflang="en" href="https://tripletalk.app/en/" />
    <link rel="alternate" hreflang="x-default" href="https://tripletalk.app/" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/tripletalk-logo.png" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
      is:inline
    />
  </head>
  <body>
    <SiteHeader
      currentPage="home"
      language={language}
      navigation={copy.navigation}
    />

    <main class="landing-main">
      <section class="hero" id="top">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">{copy.hero.eyebrow}</p>
            <h1>{copy.hero.title}</h1>
            <p class="hero-description">{copy.hero.description}</p>
            <StoreButtons
              label={copy.hero.downloadLabel}
              appStoreLabel={copy.hero.appStoreLabel}
              googlePlayLabel={copy.hero.googlePlayLabel}
              appStoreCaption={copy.hero.appStoreCaption}
              googlePlayCaption={copy.hero.googlePlayCaption}
            />
            <LanguageTicker language={language} />
          </div>

          <div class="phone-mockup" aria-label={copy.hero.previewLabel}>
            <div class="phone-frame">
              <img
                class="hero-phone-screenshot"
                src="/assets/tripletalk-lesson.webp"
                alt={copy.hero.imageAlt}
                width="920"
                height="2000"
                decoding="async"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      </section>

      <section
        class="section use-cases-section"
        id="use-cases"
        aria-labelledby="use-cases-title"
      >
        <div class="container">
          <div class="section-heading section-heading--center">
            <p class="eyebrow">{copy.useCases.eyebrow}</p>
            <h2 id="use-cases-title">{copy.useCases.title}</h2>
            <p class="section-description">{copy.useCases.description}</p>
          </div>

          <div class="use-cases-layout">
            <div
              class="use-case-tabs"
              role="tablist"
              aria-label={copy.useCases.tabsLabel}
            >
              {
                copy.useCases.items.map((useCase, index) => (
                  <button
                    type="button"
                    role="tab"
                    id={`use-case-tab-${useCase.id}`}
                    aria-controls="use-case-panel"
                    aria-selected={index === 0 ? "true" : "false"}
                    tabindex={index === 0 ? "0" : "-1"}
                    data-use-case={useCase.id}
                    data-title={useCase.title}
                    data-description={useCase.description}
                    data-cards={JSON.stringify(useCase.cards)}
                  >
                    {useCase.label}
                  </button>
                ))
              }
            </div>

            <article
              class="use-case-panel"
              id="use-case-panel"
              role="tabpanel"
              tabindex="0"
              aria-labelledby={`use-case-tab-${copy.useCases.items[0].id}`}
            >
              <div class="use-case-example">
                <p class="eyebrow">{copy.useCases.cardEyebrow}</p>
                <h3 data-use-case-title>{copy.useCases.items[0].title}</h3>
                <p data-use-case-description>
                  {copy.useCases.items[0].description}
                </p>
              </div>
              <div class="use-case-visual" aria-hidden="true">
                <div class="visual-doc">
                  <span class="visual-label">{copy.useCases.processText}</span>
                  <div class="visual-doc-text">
                    <i style="width: 72%"></i>
                    <i style="width: 18%"></i>
                    <i style="width: 30%"></i>
                    <mark data-source-word>
                      {copy.useCases.items[0].cards[0].front}
                    </mark>
                    <i style="width: 26%"></i>
                    <i style="width: 58%"></i>
                    <i style="width: 34%"></i>
                    <i style="width: 22%"></i>
                    <mark data-source-word>
                      {copy.useCases.items[0].cards[1].front}
                    </mark>
                    <i style="width: 80%"></i>
                    <i style="width: 40%"></i>
                    <mark data-source-word>
                      {copy.useCases.items[0].cards[2].front}
                    </mark>
                    <i style="width: 24%"></i>
                  </div>
                </div>
                <span class="visual-ai">✦ TripleTalk AI</span>
                <div class="visual-cards">
                  <span class="visual-label">
                    {copy.useCases.processFlashcards}
                  </span>
                  <ul class="use-case-flashcards" data-use-case-flashcards>
                    {
                      copy.useCases.items[0].cards.map((card) => (
                        <li>
                          <span>
                            <strong data-card-front>{card.front}</strong>
                            <small data-card-back>{card.back}</small>
                          </span>
                          <svg class="card-sound" viewBox="0 0 24 24">
                            <path d="M4 10v4h4l5 4V6L8 10z" />
                            <path d="M16 9a4 4 0 0 1 0 6" />
                          </svg>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section
        class="section benefits-section"
        id="features"
        aria-labelledby="benefits-title"
      >
        <div class="container">
          <div class="section-heading section-heading--center" data-reveal>
            <p class="eyebrow">{copy.benefits.eyebrow}</p>
            <h2 id="benefits-title">{copy.benefits.title}</h2>
            <p class="section-description">{copy.benefits.description}</p>
          </div>
          <ul class="benefits-grid">
            {
              copy.benefits.items.map((benefit) => (
                <li class="benefit-card" data-reveal>
                  <h3>{benefit.title}</h3>
                  <p>{benefit.description}</p>
                  <span class="benefit-icon" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={benefitIcons[benefit.icon]}
                    />
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section
        class="section how-it-works"
        id="how-it-works"
        aria-labelledby="how-it-works-title"
      >
        <div class="container">
          <div class="section-heading section-heading--center" data-reveal>
            <p class="eyebrow">{copy.how.eyebrow}</p>
            <h2 id="how-it-works-title">{copy.how.title}</h2>
            <p class="section-description">{copy.how.description}</p>
          </div>
          <ol class="steps-grid">
            {
              copy.how.steps.map((step) => (
                <li class="step" data-reveal>
                  <span class="step-number" aria-hidden="true">
                    {step.number}
                  </span>
                  <div class="step-copy">
                    <h3>{step.title}</h3>
                    <p>{step.description}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section
        class="section preview-section"
        id="preview"
        aria-labelledby="preview-title">
        <div class="container">
          <div class="section-heading section-heading--center" data-reveal>
            <p class="eyebrow">{copy.preview.eyebrow}</p>
            <h2 id="preview-title">{copy.preview.title}</h2>
            <p class="section-description">{copy.preview.description}</p>
          </div>
          <div class="preview-scroll" aria-label={copy.preview.listLabel}>
            {
              copy.preview.items.map((preview) => (
                <figure class="app-preview-card">
                  <div class="app-preview-phone">
                    <div class="app-preview-screen">
                      <img
                        class="app-preview-screenshot"
                        src={preview.image}
                        alt={preview.imageAlt}
                        width="920"
                        height="2000"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </div>
                  <figcaption>
                    <h3>{preview.title}</h3>
                    <p>{preview.description}</p>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section
        class="section school-section"
        id="teachers"
        aria-labelledby="school-title">
        <div class="container">
          <div class="school-card" data-reveal>
            <div class="school-copy">
              <p class="eyebrow">{copy.school.eyebrow}</p>
              <h2 id="school-title">{copy.school.title}</h2>
              <p class="section-description">{copy.school.description}</p>
              <ul class="school-points">
                {copy.school.points.map((point) => <li>{point}</li>)}
              </ul>
              <a class="text-link" href={copy.school.linkHref}>
                {copy.school.linkLabel} <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class="school-visual">
              <div class="school-phone">
                <img
                  src="/assets/tripletalk-school-class.webp"
                  alt={copy.school.imageAlt}
                  width="920"
                  height="2000"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        class="section pricing-section"
        id="premium"
        aria-labelledby="pricing-title"
      >
        <div class="container">
          <div
            class="section-heading section-heading--center"
            data-reveal
          >
            <p class="eyebrow">{copy.pricing.eyebrow}</p>
            <h2 id="pricing-title">{copy.pricing.title}</h2>
            <p class="section-description">{copy.pricing.description}</p>
          </div>
          <div class="pricing-grid">
            {
              copy.pricing.plans.map((plan) => (
                <article
                  class:list={["plan-card", { "plan-featured": plan.featured }]}
                  data-reveal
                >
                  {plan.badge && <span class="plan-badge">{plan.badge}</span>}
                  <h3>{plan.name}</h3>
                  <p class="plan-price">
                    {plan.price && <strong>{plan.price}</strong>}
                    <span>{plan.priceNote}</span>
                  </p>
                  <p class="plan-description">{plan.description}</p>
                  <ul>
                    {plan.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                  {plan.featured && (
                    <p class="plan-store-note">{copy.pricing.storeNote}</p>
                  )}
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section faq-section" id="faq" aria-labelledby="faq-title">
        <div class="container">
          <div
            class="section-heading section-heading--center"
            data-reveal
          >
            <p class="eyebrow">{copy.faq.eyebrow}</p>
            <h2 id="faq-title">{copy.faq.title}</h2>
          </div>
          <div class="faq-list">
            {
              copy.faq.items.map((item) => (
                <details class="faq-item">
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))
            }
          </div>
          <div class="faq-contact" data-reveal>
            <div>
              <strong>{copy.faq.contactTitle}</strong>
              <p>{copy.faq.contactText}</p>
            </div>
            <a class="faq-contact-primary" href="/support/">
              {copy.faq.contactLabel}
            </a>
          </div>
          <p class="faq-more">
            <a class="text-link" href={guideHref}>
              {copy.faq.moreLabel} <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>

      <section class="download" id="download" aria-labelledby="download-title">
        <div class="container download-inner">
          <div class="download-copy">
            <p class="eyebrow">{copy.download.eyebrow}</p>
            <h2 id="download-title">{copy.download.title}</h2>
            <p class="download-description">{copy.download.description}</p>
          </div>
          <div class="download-actions">
            <StoreButtons
              label={copy.hero.downloadLabel}
              appStoreLabel={copy.hero.appStoreLabel}
              googlePlayLabel={copy.hero.googlePlayLabel}
              appStoreCaption={copy.hero.appStoreCaption}
              googlePlayCaption={copy.hero.googlePlayCaption}
            />
          </div>
        </div>
      </section>
    </main>

    <SiteFooter currentPage="home" language={language} content={copy.footer} />

    <script>
      type Flashcard = { front: string; back: string };

      const useCaseTabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-use-case]"),
      );
      const useCasePanel =
        document.querySelector<HTMLElement>("#use-case-panel");
      const useCaseTitle = document.querySelector<HTMLElement>(
        "[data-use-case-title]",
      );
      const useCaseDescription = document.querySelector<HTMLElement>(
        "[data-use-case-description]",
      );
      const useCaseCardFronts =
        document.querySelectorAll<HTMLElement>("[data-card-front]");
      const useCaseCardBacks =
        document.querySelectorAll<HTMLElement>("[data-card-back]");
      const useCaseSourceWords =
        document.querySelectorAll<HTMLElement>("[data-source-word]");

      function cardsForTab(tab: HTMLButtonElement): Flashcard[] {
        try {
          return JSON.parse(tab.dataset.cards ?? "[]") as Flashcard[];
        } catch {
          return [];
        }
      }

      function renderUseCase(tab: HTMLButtonElement, focus = false) {
        if (useCaseTitle) useCaseTitle.textContent = tab.dataset.title ?? "";
        if (useCaseDescription)
          useCaseDescription.textContent = tab.dataset.description ?? "";

        const cards = cardsForTab(tab);
        useCaseCardFronts.forEach((front, index) => {
          front.textContent = cards[index]?.front ?? "";
        });
        useCaseCardBacks.forEach((back, index) => {
          back.textContent = cards[index]?.back ?? "";
        });
        useCaseSourceWords.forEach((word, index) => {
          word.textContent = cards[index]?.front ?? "";
        });

        // Replay the entrance animation so switching tabs feels like new cards are made.
        if (useCasePanel) {
          useCasePanel.classList.remove("is-animating");
          void useCasePanel.offsetWidth;
          useCasePanel.classList.add("is-animating");
        }

        if (useCasePanel) useCasePanel.setAttribute("aria-labelledby", tab.id);
        useCaseTabs.forEach((item) => {
          const isActive = item === tab;
          item.setAttribute("aria-selected", String(isActive));
          item.tabIndex = isActive ? 0 : -1;
        });

        if (focus) tab.focus();
      }

      // Sections fade in as they scroll into view. Without IntersectionObserver or with reduced
      // motion everything stays visible, because the hidden state only applies under .reveal-ready.
      const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (
        "IntersectionObserver" in window &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        document.documentElement.classList.add("reveal-ready");
        revealItems.forEach((item) => observer.observe(item));
      }

      useCaseTabs.forEach((tab, index) => {
        tab.addEventListener("click", () => renderUseCase(tab));
        tab.addEventListener("keydown", (event) => {
          let nextIndex: number | null = null;

          if (event.key === "ArrowRight" || event.key === "ArrowDown")
            nextIndex = (index + 1) % useCaseTabs.length;
          if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            nextIndex = (index - 1 + useCaseTabs.length) % useCaseTabs.length;
          }
          if (event.key === "Home") nextIndex = 0;
          if (event.key === "End") nextIndex = useCaseTabs.length - 1;

          if (nextIndex !== null) {
            event.preventDefault();
            const nextTab = useCaseTabs[nextIndex];
            if (nextTab) renderUseCase(nextTab, true);
          }
        });
      });
    </script>
  </body>
</html>
