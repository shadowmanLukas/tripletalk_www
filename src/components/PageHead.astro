---
// <head> content for the subpages: title, description, canonical, hreflang and link previews.
import { pageUrl, siteLanguages, subPageMeta, type SiteLanguage, type SubPage } from "../lib/site-pages";
import SocialMeta from "./SocialMeta.astro";

interface Props {
  page: SubPage;
  language: SiteLanguage;
}

const { page, language } = Astro.props;
const meta = subPageMeta[page][language];
const canonical = pageUrl(page, language);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={meta.description} />
<meta name="robots" content="index, follow" />
<SocialMeta
  title={meta.shareTitle}
  description={meta.description}
  url={canonical}
  image={`${page}-${language}`}
  imageAlt={meta.imageAlt}
  locale={language === "pl" ? "pl_PL" : "en_US"}
  alternateLocale={language === "pl" ? "en_US" : "pl_PL"}
/>
<title>{meta.title}</title>
<link rel="canonical" href={canonical} />
{siteLanguages.map((code) => <link rel="alternate" hreflang={code} href={pageUrl(page, code)} />)}
<link rel="alternate" hreflang="x-default" href={pageUrl(page, "pl")} />
<link rel="icon" href="/favicon.png" type="image/png" />
<link rel="apple-touch-icon" href="/assets/tripletalk-logo.png" />
