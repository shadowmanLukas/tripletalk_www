---
// A small bar offering the same page in the other language (see src/scripts/language-suggestion.ts).
import { pagePath, type SiteLanguage, type SitePage } from "../lib/site-pages";

interface Props {
  page: SitePage;
  language: SiteLanguage;
}

const { page, language } = Astro.props;
const target: SiteLanguage = language === "pl" ? "en" : "pl";
// Written in the target language, because that is the language the visitor reads.
const copy = {
  en: { text: "This page is also available in English.", link: "Switch to English", close: "Close" },
  pl: { text: "Ta strona jest dostępna także po polsku.", link: "Przejdź na polski", close: "Zamknij" },
}[target];
---

<div
  id="language-suggestion"
  class="language-suggestion"
  role="region"
  aria-label={copy.text}
  lang={target}
  data-page-language={language}
  data-target-language={target}
  hidden
>
  <div class="container language-suggestion-inner">
    <p>{copy.text}</p>
    <a href={pagePath(page, target)} hreflang={target} data-suggestion-link>
      {copy.link} <span aria-hidden="true">→</span>
    </a>
    <button type="button" aria-label={copy.close} data-suggestion-dismiss>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>
</div>

<script>
  import "../scripts/language-suggestion";
</script>
