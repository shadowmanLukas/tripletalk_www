---
import { landingContent } from "../lib/landing-content";
import { pagePath, type SitePage } from "../lib/site-pages";
import CookieConsent from "./CookieConsent.astro";

type Page = SitePage | "notFound";
type Language = "pl" | "en";

interface Props {
  currentPage?: Page;
  language?: Language;
}

const { currentPage = "home", language = "pl" } = Astro.props;
const labels = landingContent[language].footer;
const links = [
  { page: "privacy", key: "footerPrivacy", label: labels.privacy },
  { page: "terms", key: "footerTerms", label: labels.terms },
  { page: "guide", key: "footerGuide", label: labels.guide },
  { page: "support", key: "footerSupport", label: labels.support },
] as const;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p>© 2026 craftapp</p>
    </div>
    <nav aria-label={labels.navigationLabel}>
      {
        links.map((link) => (
          <a
            href={pagePath(link.page, language)}
            data-i18n={link.key}
            data-href-pl={pagePath(link.page, "pl")}
            data-href-en={pagePath(link.page, "en")}
            aria-current={currentPage === link.page ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <button type="button" id="cookie-settings" class="footer-cookie-settings" data-consent-i18n="settings" hidden>
        Cookies
      </button>
    </nav>
  </div>
</footer>
<CookieConsent privacyHref={pagePath("privacy", language)} />
