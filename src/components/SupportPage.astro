---
// The contact page, one language per URL (/support/ and /en/support/).
import "../styles/global.css";
import { pagePath, type SiteLanguage } from "../lib/site-pages";
import PageHead from "./PageHead.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  language: SiteLanguage;
}

const { language } = Astro.props;

const content = {
  pl: {
    eyebrow: "Kontakt",
    title: "Jak możemy pomóc?",
    intro: "Coś nie działa albo masz pytanie o aplikację czy swoje konto? Napisz do nas, chętnie pomożemy.",
    emailLabel: "Napisz do nas",
    emailCopy: "Kopiuj adres",
    emailCopied: "Skopiowano",
    optionsLabel: "Inne sposoby uzyskania pomocy",
    guideTitle: "Znajdź odpowiedź w instrukcji",
    guideText: "Wszystkie funkcje opisane krok po kroku i odpowiedzi na najczęstsze pytania.",
    guideLink: "Otwórz instrukcję",
    appTitle: "Zgłoś problem w aplikacji",
    appText:
      "W aplikacji wybierz Więcej › Wyślij opinię. Jeśli dołączysz zrzut ekranu, szybciej rozwiążemy Twoje zgłoszenie.",
    purchasesTitle: "Subskrypcja i zakupy",
    purchasesText:
      "Masz pytania o subskrypcję Premium albo zakupione pakiety fiszek? Zasady płatności, odnowień i zwrotów znajdziesz w regulaminie.",
    purchasesLink: "Regulamin",
  },
  en: {
    eyebrow: "Contact",
    title: "How can we help?",
    intro: "Something not working, or have a question about the app or your account? Write to us, we're happy to help.",
    emailLabel: "Email us",
    emailCopy: "Copy address",
    emailCopied: "Copied",
    optionsLabel: "Other ways to get help",
    guideTitle: "Find the answer in the guide",
    guideText: "Every feature explained step by step, plus answers to the most common questions.",
    guideLink: "Open the guide",
    appTitle: "Report a problem in the app",
    appText: "In the app, go to More › Send Feedback. Adding a screenshot helps us resolve your report faster.",
    purchasesTitle: "Subscription and purchases",
    purchasesText:
      "Questions about your Premium subscription or flashcard packs you've bought? You'll find the rules on payments, renewals and refunds in the Terms of Service.",
    purchasesLink: "Terms of Service",
  },
}[language];
---

<!doctype html>
<html lang={language}>
  <head>
    <PageHead page="support" language={language} />
  </head>
  <body class="support-body">
    <SiteHeader currentPage="support" language={language} />

    <main class="support-page">
      <section class="support-hero" aria-labelledby="support-title">
        <div class="container">
          <div class="support-heading">
            <p class="eyebrow">{content.eyebrow}</p>
            <h1 id="support-title">{content.title}</h1>
            <p class="support-intro">{content.intro}</p>
          </div>

          <div class="support-mail">
            <span class="support-mail-label">{content.emailLabel}</span>
            <div class="support-email-row">
              <!--email_off-->
              <a class="support-email" href="mailto:support@tripletalk.app">support@tripletalk.app</a>
              <!--/email_off-->
              <button
                class="support-copy"
                type="button"
                aria-label={content.emailCopy}
                data-copy-email
                data-label-copy={content.emailCopy}
                data-label-copied={content.emailCopied}
              >
                <svg class="support-copy-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="9" y="9" width="11" height="11" rx="2.5"></rect>
                  <path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"></path>
                </svg>
                <svg class="support-copied-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7.5"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </section>

      <section class="support-options" aria-label={content.optionsLabel}>
        <div class="container support-options-grid">
          <article class="benefit-card support-option">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5zM4 5.5v16M8 7h8M8 11h6"></path></svg>
            </span>
            <h2>{content.guideTitle}</h2>
            <p>{content.guideText}</p>
            <a class="text-link" href={pagePath("guide", language)}>{content.guideLink} <span aria-hidden="true">→</span></a>
          </article>
          <article class="benefit-card support-option">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="3"></rect><path d="M10 18.5h4M12 7v5M12 14.5v.5"></path></svg>
            </span>
            <h2>{content.appTitle}</h2>
            <p>{content.appText}</p>
          </article>
          <article class="benefit-card support-option">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2.5"></rect><path d="M3 10h18M7 15h4"></path></svg>
            </span>
            <h2>{content.purchasesTitle}</h2>
            <p>{content.purchasesText}</p>
            <a class="text-link" href={pagePath("terms", language)}>{content.purchasesLink} <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </section>
    </main>

    <SiteFooter currentPage="support" language={language} />

    <script>
      const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");

      copyButton?.addEventListener("click", async () => {
        const copyLabel = copyButton.dataset.labelCopy ?? "";
        try {
          await navigator.clipboard.writeText("support@tripletalk.app");
          copyButton.classList.add("is-copied");
          copyButton.setAttribute("aria-label", copyButton.dataset.labelCopied ?? copyLabel);
          window.setTimeout(() => {
            copyButton.classList.remove("is-copied");
            copyButton.setAttribute("aria-label", copyLabel);
          }, 2000);
        } catch {
          // Clipboard access can be blocked; the address stays visible and selectable.
        }
      });
    </script>
  </body>
</html>
