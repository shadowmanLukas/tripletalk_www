              { front: "strengths", back: "Stärken" },
            ],
          },
          travel: {
            title: "Prepare vocabulary for your trip",
            description:
              "Paste materials or add your own text. TripleTalk AI prepares vocabulary for hotels, restaurants, airports and transport.",
            cards: [
              { front: "reservation", back: "Reservierung" },
              { front: "boarding pass", back: "Bordkarte" },
              { front: "check-in", back: "Check-in" },
            ],
          },
        },
      } as const;

      type Language = keyof typeof translations;
      type UseCaseId = keyof (typeof useCaseContent)["en"];

      const menuToggle = document.querySelector(".menu-toggle");
      const navLinks = document.querySelector(".nav-links");
      const translatedNodes = document.querySelectorAll<HTMLElement>("[data-i18n]");
      const ariaTranslatedNodes = document.querySelectorAll<HTMLElement>("[data-i18n-aria-label]");
      const localizedDescription = document.querySelector<HTMLMetaElement>("[data-localized-description]");
      const useCaseTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-use-case]"));
      const useCasePanel = document.querySelector<HTMLElement>("#use-case-panel");
      const useCaseTitle = document.querySelector<HTMLElement>("[data-use-case-title]");
      const useCaseDescription = document.querySelector<HTMLElement>("[data-use-case-description]");
      const useCaseCardFronts = document.querySelectorAll<HTMLElement>("[data-card-front]");
      const useCaseCardBacks = document.querySelectorAll<HTMLElement>("[data-card-back]");

      let currentLanguage: Language = "en";
      let currentUseCase: UseCaseId = "school";

      function renderUseCase(useCase: UseCaseId, focus = false) {
        currentUseCase = useCase;
        const content = useCaseContent[currentLanguage][useCase];
        const activeTab = useCaseTabs.find((tab) => tab.dataset.useCase === useCase);

        if (useCaseTitle) useCaseTitle.textContent = content.title;
        if (useCaseDescription) useCaseDescription.textContent = content.description;
        useCaseCardFronts.forEach((front, index) => {
          front.textContent = content.cards[index]?.front ?? "";
        });
        useCaseCardBacks.forEach((back, index) => {
          back.textContent = content.cards[index]?.back ?? "";
        });
        if (useCasePanel && activeTab) useCasePanel.setAttribute("aria-labelledby", activeTab.id);

        useCaseTabs.forEach((tab) => {
          const isActive = tab.dataset.useCase === useCase;
          tab.setAttribute("aria-selected", String(isActive));
          tab.tabIndex = isActive ? 0 : -1;
        });

        if (focus) activeTab?.focus();
      }

      function setLanguage(language: Language) {
        currentLanguage = language;
        document.documentElement.lang = language;
        document.title = translations[language].pageTitle;
        localizedDescription?.setAttribute("content", translations[language].metaDescription);

        translatedNodes.forEach((node) => {
          const key = node.dataset.i18n as keyof (typeof translations)["pl"] | undefined;
          if (key && key in translations[language]) node.textContent = translations[language][key];
        });

        ariaTranslatedNodes.forEach((node) => {
          const key = node.dataset.i18nAriaLabel as keyof (typeof translations)["pl"] | undefined;
          if (key && key in translations[language]) node.setAttribute("aria-label", translations[language][key]);
        });

        renderUseCase(currentUseCase);
      }

      menuToggle?.addEventListener("click", () => {
        const expanded = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!expanded));
        navLinks?.classList.toggle("open", !expanded);
      });

      navLinks?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuToggle?.setAttribute("aria-expanded", "false");
          navLinks.classList.remove("open");
        });
      });

      useCaseTabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          const useCase = tab.dataset.useCase as UseCaseId | undefined;
          if (useCase) renderUseCase(useCase);
        });

        tab.addEventListener("keydown", (event) => {
          let nextIndex: number | null = null;

          if (event.key === "ArrowRight" || event.key === "ArrowDown") nextIndex = (index + 1) % useCaseTabs.length;
          if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            nextIndex = (index - 1 + useCaseTabs.length) % useCaseTabs.length;
          }
          if (event.key === "Home") nextIndex = 0;
          if (event.key === "End") nextIndex = useCaseTabs.length - 1;

          if (nextIndex !== null) {
            event.preventDefault();
            const useCase = useCaseTabs[nextIndex]?.dataset.useCase as UseCaseId | undefined;
            if (useCase) renderUseCase(useCase, true);
          }
        });
      });

      setLanguage(await getVisitorLanguage());
    </script>
  </body>
</html>
