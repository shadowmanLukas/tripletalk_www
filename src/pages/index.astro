---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

const useCases = [
  { id: "school", labelKey: "useCaseSchool", label: "School" },
  { id: "presentation", labelKey: "useCasePresentation", label: "Presentation" },
  { id: "business", labelKey: "useCaseBusiness", label: "Business meeting" },
  { id: "interview", labelKey: "useCaseInterview", label: "Job interview" },
  { id: "travel", labelKey: "useCaseTravel", label: "Travel" },
];

const steps = [
  {
    number: "01",
    icon: "document",
    titleKey: "stepMaterialTitle",
    descriptionKey: "stepMaterialDescription",
    title: "Add your material",
    description: "Paste text or add a photo.",
  },
  {
    number: "02",
    icon: "ai",
    titleKey: "stepAiTitle",
    descriptionKey: "stepAiDescription",
    title: "TripleTalk AI creates flashcards",
    description: "Automatically prepares translations, examples and audio.",
  },
  {
    number: "03",
    icon: "review",
    titleKey: "stepReviewTitle",
    descriptionKey: "stepReviewDescription",
    title: "Practise and remember",
    description: "Smart reviews help you remember vocabulary for longer.",
  },
];

const previews = [
  {
    number: "01",
    image: "/assets/tripletalk-add-flashcards.png",
    titleKey: "previewCreateTitle",
    descriptionKey: "previewCreateDescription",
    title: "Create flashcards with TripleTalk AI",
    description: "Paste text or add a photo. TripleTalk AI does the rest.",
  },
  {
    number: "02",
    image: "/assets/tripletalk-audio-learning.png",
    titleKey: "previewLearnTitle",
    descriptionKey: "previewLearnDescription",
    title: "Learn more effectively",
    description: "Listen to audio lessons and reinforce vocabulary with smart reviews.",
  },
  {
    number: "03",
    image: "/assets/tripletalk-progress-dashboard.png",
    titleKey: "previewProgressTitle",
    descriptionKey: "previewProgressDescription",
    title: "Track your progress",
    description: "Track your vocabulary growth and maintain a consistent learning routine.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Turn notes, presentations, articles and any text into TripleTalk AI flashcards with translations, examples and audio."
      data-localized-description
    />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tripletalk.app/" />
    <meta property="og:title" content="TripleTalk – Turn Any Text into TripleTalk AI Flashcards" />
    <meta
      property="og:description"
      content="Turn notes, presentations, articles and any text into TripleTalk AI flashcards with translations, examples and audio."
    />
    <meta property="og:image" content="https://tripletalk.app/assets/tripletalk-logo-with-background.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="TripleTalk – Turn Any Text into TripleTalk AI Flashcards" />
    <meta
      name="twitter:description"
      content="Turn notes, presentations, articles and any text into TripleTalk AI flashcards with translations, examples and audio."
    />
    <meta name="twitter:image" content="https://tripletalk.app/assets/tripletalk-logo-with-background.png" />
    <title>TripleTalk – Turn Any Text into TripleTalk AI Flashcards</title>
    <link rel="canonical" href="https://tripletalk.app/" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/tripletalk-logo.png" />
  </head>
  <body>
    <SiteHeader currentPage="home" />

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow" data-i18n="heroEyebrow">TripleTalk AI Flashcards</p>
            <h1 data-i18n="heroTitle">Turn any text into TripleTalk AI flashcards.</h1>
            <p class="hero-description" data-i18n="heroDescription">
              Paste any text or take a photo. TripleTalk AI automatically creates flashcards with translations,
              examples and audio.
            </p>
            <p class="hero-value" data-i18n="heroValue">Learn the words you really need.</p>
            <div class="store-actions" aria-label="Download app" data-i18n-aria-label="downloadAppLabel">
              <a href="TODO" aria-label="Download on the App Store">App Store</a>
              <a href="TODO" aria-label="Get it on Google Play">Google Play</a>
            </div>
            <p class="hero-offer" data-i18n="downloadOffer">
              3 days of Premium free • 100 TripleTalk AI flashcards to get started
            </p>
          </div>

          <div class="phone-mockup" aria-label="TripleTalk app preview" data-i18n-aria-label="phonePreviewLabel">
            <div class="phone-frame">
              <img
                class="hero-phone-screenshot"
                src="/assets/tripletalk-app-home.png"
                alt=""
                width="720"
                height="1565"
              />
            </div>
          </div>
        </div>
      </section>

      <section class="section use-cases-section" id="features" aria-labelledby="use-cases-title">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow" data-i18n="useCasesEyebrow">Your material. Your lesson.</p>
            <h2 id="use-cases-title" data-i18n="useCasesTitle">Any material can become your lesson.</h2>
            <p class="section-description" data-i18n="useCasesDescription">
              Paste text or add a photo. TripleTalk AI selects the most important words and creates a ready-to-learn
              flashcard set.
            </p>
          </div>

          <div class="use-cases-layout">
            <div
              class="use-case-tabs"
              role="tablist"
              aria-label="Choose a learning goal"
              data-i18n-aria-label="useCasesTabsLabel"
            >
              {
                useCases.map((useCase, index) => (
                  <button
                    type="button"
                    role="tab"
                    id={`use-case-tab-${useCase.id}`}
                    aria-controls="use-case-panel"
                    aria-selected={index === 0 ? "true" : "false"}
                    tabindex={index === 0 ? "0" : "-1"}
                    data-use-case={useCase.id}
                    data-i18n={useCase.labelKey}
                  >
                    {useCase.label}
                  </button>
                ))
              }
            </div>

            <article
              class="use-case-panel"
              id="use-case-panel"
              role="tabpanel"
              tabindex="0"
              aria-labelledby="use-case-tab-school"
            >
              <div class="use-case-example">
                <p class="eyebrow" data-i18n="useCaseExampleEyebrow">TripleTalk AI creates your flashcards</p>
                <h3 data-use-case-title>Prepare for a test</h3>
                <p data-use-case-description>
                  Paste your lesson material or list of topics. TripleTalk will create flashcards with the most
                  important vocabulary.
                </p>
              </div>
              <div class="use-case-process" aria-hidden="true">
                <div class="process-stage process-source">
                  <span data-i18n="processText">Text</span>
                  <div class="source-lines">
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                </div>
                <span class="process-arrow">→</span>
                <div class="process-stage generated-card">
                  <span data-i18n="processFlashcards">TripleTalk AI flashcards</span>
                  <ul class="use-case-flashcards" data-use-case-flashcards>
                    <li>
                      <strong data-card-front>vocabulary</strong>
                      <small data-card-back>Wortschatz</small>
                    </li>
                    <li>
                      <strong data-card-front>homework</strong>
                      <small data-card-back>Hausaufgaben</small>
                    </li>
                    <li>
                      <strong data-card-front>exam</strong>
                      <small data-card-back>Prüfung</small>
                    </li>
                  </ul>
                </div>
                <span class="process-arrow">→</span>
                <div class="process-stage process-learning">
                  <span data-i18n="processLearning">Learning</span>
                  <strong data-i18n="processPractice">Practise</strong>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="section how-it-works" aria-labelledby="how-it-works-title">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow" data-i18n="howEyebrow">How it works</p>
            <h2 id="how-it-works-title" data-i18n="howTitle">How TripleTalk AI works</h2>
            <p class="section-description" data-i18n="howDescription">
              It only takes three steps to turn your own material into ready-to-learn flashcards and start learning.
            </p>
          </div>
          <ol class="steps-grid">
            {
              steps.map((step) => (
                <li class="step">
                  <div class="step-marker" aria-hidden="true">
                    <span class="step-number">{step.number}</span>
                    <span class={`step-icon step-icon-${step.icon}`}></span>
                  </div>
                  <div class="step-copy">
                    <h3 data-i18n={step.titleKey}>{step.title}</h3>
                    <p data-i18n={step.descriptionKey}>{step.description}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="section preview-section" aria-labelledby="preview-title">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow" data-i18n="previewEyebrow">App preview</p>
            <h2 id="preview-title" data-i18n="previewTitle">See how TripleTalk helps you learn.</h2>
          </div>
          <div class="preview-scroll" aria-label="App screenshot placeholders" data-i18n-aria-label="previewListLabel">
            {
              previews.map((preview) => (
                <figure class="app-preview-card">
                  <div class="app-preview-phone">
                    <img
                      class="app-preview-screenshot"
                      src={preview.image}
                      alt=""
                      width="1206"
                      height="2622"
                      loading="lazy"
                    />
                  </div>
                  <figcaption>
                    <h3 data-i18n={preview.titleKey}>{preview.title}</h3>
                    <p data-i18n={preview.descriptionKey}>{preview.description}</p>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section class="download" id="download" aria-labelledby="download-title">
        <div class="container download-inner">
          <div class="download-copy">
            <p class="eyebrow" data-i18n="downloadEyebrow">Download</p>
            <h2 id="download-title" data-i18n="downloadTitle">Learn the vocabulary you really need.</h2>
            <p class="download-description" data-i18n="downloadDescription">
              Download TripleTalk and turn your own materials into TripleTalk AI flashcards.
            </p>
          </div>
          <div class="download-actions">
            <div class="store-actions" aria-label="Download app" data-i18n-aria-label="downloadAppLabel">
              <a href="TODO" aria-label="Download on the App Store">App Store</a>
              <a href="TODO" aria-label="Get it on Google Play">Google Play</a>
            </div>
            <p class="download-offer" data-i18n="downloadOffer">
              3 days of Premium free • 100 TripleTalk AI flashcards to get started
            </p>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter currentPage="home" />

