---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Questions about TripleTalk? Contact us about the app, your account, privacy or data requests."
    />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tripletalk.app/support/" />
    <meta property="og:title" content="TripleTalk Contact" />
    <meta
      property="og:description"
      content="Questions about TripleTalk? Contact us about the app, your account, privacy or data requests."
    />
    <meta property="og:image" content="https://tripletalk.app/assets/tripletalk-logo-with-background.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="TripleTalk Contact" />
    <meta
      name="twitter:description"
      content="Questions about TripleTalk? Contact us about the app, your account, privacy or data requests."
    />
    <meta name="twitter:image" content="https://tripletalk.app/assets/tripletalk-logo-with-background.png" />
    <title>TripleTalk Contact</title>
    <link rel="canonical" href="https://tripletalk.app/support/" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/tripletalk-logo.png" />
  </head>
  <body class="support-body">
    <SiteHeader currentPage="support" />

    <main class="support-page">
      <section class="support-hero" aria-labelledby="support-title">
        <div class="container">
          <div class="support-card">
            <h1 class="eyebrow" id="support-title" data-i18n="supportEyebrow">TripleTalk Contact</h1>
            <p class="support-intro" data-i18n="supportIntro">
              Questions about TripleTalk? Contact us about the app, your account, privacy or data requests.
            </p>

            <div class="support-contact" aria-label="Support email">
              <span data-i18n="emailLabel">Email</span>
              <!--email_off-->
              <strong class="support-email">support@tripletalk.app</strong>
              <!--/email_off-->
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter currentPage="support" />

    <script>
      import { getVisitorLanguage } from "../scripts/visitor-language";

      const translations = {
        pl: {
          navFeatures: "Funkcje",
          navDownload: "Pobierz",
          navGuide: "Instrukcja",
          supportEyebrow: "Kontakt TripleTalk",
          supportIntro:
            "Masz pytanie dotyczące TripleTalk? Skontaktuj się z nami w sprawie aplikacji, konta, prywatności lub wniosków dotyczących danych.",
          emailLabel: "E-mail",
          footerPrivacy: "Polityka prywatności",
          footerTerms: "Regulamin",
          footerSupport: "Kontakt",
          pageTitle: "Kontakt TripleTalk",
        },
        en: {
          navFeatures: "Features",
          navDownload: "Download",
          navGuide: "Guide",
          supportEyebrow: "TripleTalk Contact",
          supportIntro:
            "Questions about TripleTalk? Contact us about the app, your account, privacy or data requests.",
          emailLabel: "Email",
          footerPrivacy: "Privacy Policy",
          footerTerms: "Terms of Service",
          footerSupport: "Contact",
          pageTitle: "TripleTalk Contact",
        },
      };

      const menuToggle = document.querySelector(".menu-toggle");
      const navLinks = document.querySelector(".nav-links");
      const translatedNodes = document.querySelectorAll("[data-i18n]");

      function setLanguage(language: "pl" | "en") {
        document.documentElement.lang = language;
        document.title = translations[language].pageTitle;

        translatedNodes.forEach((node) => {
          const key = node.getAttribute("data-i18n");
          if (key && key in translations[language]) {
            node.textContent = translations[language][key as keyof (typeof translations)["pl"]];
          }
        });
      }

      menuToggle?.addEventListener("click", () => {
        const expanded = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!expanded));
        navLinks?.classList.toggle("open", !expanded);
      });

      navLinks?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuToggle?.setAttribute("aria-expanded", "false");
          navLinks.classList.remove("open");
        });
      });

      setLanguage(await getVisitorLanguage());
    </script>
  </body>
</html>
