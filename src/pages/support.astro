---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SocialMeta from "../components/SocialMeta.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Masz pytanie o aplikację, konto albo płatności? Napisz do nas, chętnie pomożemy. Questions about the app, your account or payments? We are happy to help." />
    <meta name="robots" content="index, follow" />
    <SocialMeta
      title="Kontakt · Contact | TripleTalk"
      description="Masz pytanie o aplikację, konto albo płatności? Napisz do nas, chętnie pomożemy. Questions about the app, your account or payments? We are happy to help."
      url="https://tripletalk.app/support/"
      image="support"
      imageAlt="Kontakt z TripleTalk / Contact TripleTalk"
    />
    <title>Contact | TripleTalk</title>
    <link rel="canonical" href="https://tripletalk.app/support/" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/tripletalk-logo.png" />
  </head>
  <body class="support-body">
    <SiteHeader currentPage="support" />

    <main class="support-page">
      <section class="support-hero" aria-labelledby="support-title">
        <div class="container">
          <div class="support-heading">
            <p class="eyebrow" data-i18n="supportEyebrow">Contact</p>
            <h1 id="support-title" data-i18n="supportTitle">How can we help?</h1>
            <p class="support-intro" data-i18n="supportIntro">
              Something not working, or have a question about the app or your account? Write to us, we're happy to help.
            </p>
          </div>

          <div class="support-mail">
            <span class="support-mail-label" data-i18n="emailLabel">Email us</span>
            <div class="support-email-row">
              <!--email_off-->
              <a class="support-email" href="mailto:support@tripletalk.app">support@tripletalk.app</a>
              <!--/email_off-->
              <button
                class="support-copy"
                type="button"
                aria-label="Copy address"
                data-copy-email
                data-i18n-label="emailCopy"
              >
                <svg class="support-copy-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="9" y="9" width="11" height="11" rx="2.5"></rect>
                  <path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"></path>
                </svg>
                <svg class="support-copied-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7.5"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </section>

      <section class="support-options" aria-label="Other ways to get help" data-i18n-label="optionsLabel">
        <div class="container support-options-grid">
          <article class="benefit-card support-option">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5zM4 5.5v16M8 7h8M8 11h6"></path></svg>
            </span>
            <h2 data-i18n="guideTitle">Find the answer in the guide</h2>
            <p data-i18n="guideText">Every feature explained step by step, plus answers to the most common questions.</p>
            <a class="text-link" href="/guide/"><span data-i18n="guideLink">Open the guide</span> <span aria-hidden="true">→</span></a>
          </article>
          <article class="benefit-card support-option">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="3"></rect><path d="M10 18.5h4M12 7v5M12 14.5v.5"></path></svg>
            </span>
            <h2 data-i18n="appTitle">Report a problem in the app</h2>
            <p data-i18n="appText">
              In the app, go to More › Send Feedback. Adding a screenshot helps us resolve your report faster.
            </p>
          </article>
          <article class="benefit-card support-option">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2.5"></rect><path d="M3 10h18M7 15h4"></path></svg>
            </span>
            <h2 data-i18n="purchasesTitle">Subscription and purchases</h2>
            <p data-i18n="purchasesText">
              Questions about your Premium subscription or flashcard packs you've bought? You'll find the rules on payments, renewals and refunds in the Terms of Service.
            </p>
            <a class="text-link" href="/terms/"><span data-i18n="purchasesLink">Terms of Service</span> <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </section>
    </main>

    <SiteFooter currentPage="support" />

    <script>
      import { getVisitorLanguage } from "../scripts/visitor-language";

      const translations = {
        pl: {
          navFeatures: "O aplikacji",
          navHow: "Jak to działa",
          navTeachers: "Dla nauczycieli",
          navPricing: "Premium",
          supportEyebrow: "Kontakt",
          supportTitle: "Jak możemy pomóc?",
          supportIntro:
            "Coś nie działa albo masz pytanie o aplikację czy swoje konto? Napisz do nas, chętnie pomożemy.",
          emailLabel: "Napisz do nas",
          emailCopy: "Kopiuj adres",
          emailCopied: "Skopiowano",
          optionsLabel: "Inne sposoby uzyskania pomocy",
          guideTitle: "Znajdź odpowiedź w instrukcji",
          guideText: "Wszystkie funkcje opisane krok po kroku i odpowiedzi na najczęstsze pytania.",
          guideLink: "Otwórz instrukcję",
          appTitle: "Zgłoś problem w aplikacji",
          appText:
            "W aplikacji wybierz Więcej › Wyślij opinię. Jeśli dołączysz zrzut ekranu, szybciej rozwiążemy Twoje zgłoszenie.",
          purchasesTitle: "Subskrypcja i zakupy",
          purchasesText:
            "Masz pytania o subskrypcję Premium albo zakupione pakiety fiszek? Zasady płatności, odnowień i zwrotów znajdziesz w regulaminie.",
          purchasesLink: "Regulamin",
          footerPrivacy: "Polityka prywatności",
          footerTerms: "Regulamin",
          footerGuide: "Instrukcja",
          footerSupport: "Kontakt",
          pageTitle: "Kontakt | TripleTalk",
        },
        en: {
          navFeatures: "About the app",
          navHow: "How it works",
          navTeachers: "For teachers",
          navPricing: "Premium",
          supportEyebrow: "Contact",
          supportTitle: "How can we help?",
          supportIntro:
            "Something not working, or have a question about the app or your account? Write to us, we're happy to help.",
          emailLabel: "Email us",
          emailCopy: "Copy address",
          emailCopied: "Copied",
          optionsLabel: "Other ways to get help",
          guideTitle: "Find the answer in the guide",
          guideText: "Every feature explained step by step, plus answers to the most common questions.",
          guideLink: "Open the guide",
          appTitle: "Report a problem in the app",
          appText: "In the app, go to More › Send Feedback. Adding a screenshot helps us resolve your report faster.",
          purchasesTitle: "Subscription and purchases",
          purchasesText:
            "Questions about your Premium subscription or flashcard packs you've bought? You'll find the rules on payments, renewals and refunds in the Terms of Service.",
          purchasesLink: "Terms of Service",
          footerPrivacy: "Privacy Policy",
          footerTerms: "Terms of Service",
          footerGuide: "Guide",
          footerSupport: "Contact",
          pageTitle: "Contact | TripleTalk",
        },
      };

      const translatedNodes = document.querySelectorAll("[data-i18n]");
      const labelledNodes = document.querySelectorAll("[data-i18n-label]");
      const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
      let currentLanguage: "pl" | "en" = "en";

      function setLanguage(language: "pl" | "en") {
        currentLanguage = language;
        document.documentElement.lang = language;
        document.title = translations[language].pageTitle;

        translatedNodes.forEach((node) => {
          const key = node.getAttribute("data-i18n");
          if (key && key in translations[language]) {
            node.textContent = translations[language][key as keyof (typeof translations)["pl"]];
          }
        });

        labelledNodes.forEach((node) => {
          const key = node.getAttribute("data-i18n-label");
          if (key && key in translations[language]) {
            node.setAttribute("aria-label", translations[language][key as keyof (typeof translations)["pl"]]);
          }
        });
      }

      copyButton?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("support@tripletalk.app");
          copyButton.classList.add("is-copied");
          copyButton.setAttribute("aria-label", translations[currentLanguage].emailCopied);
          window.setTimeout(() => {
            copyButton.classList.remove("is-copied");
            copyButton.setAttribute("aria-label", translations[currentLanguage].emailCopy);
          }, 2000);
        } catch {
          // Clipboard access can be blocked; the address stays visible and selectable.
        }
      });

      document.addEventListener("tripletalk:language", (event) => {
        setLanguage((event as CustomEvent<"pl" | "en">).detail);
      });

      setLanguage(await getVisitorLanguage());
    </script>
  </body>
</html>
