---
import "../styles/global.css";
import MarkdownDocument from "../components/MarkdownDocument.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { loadLegalDocument } from "../lib/documents";

const documents = [
  { language: "pl" as const, document: await loadLegalDocument("terms", "pl") },
  { language: "en" as const, document: await loadLegalDocument("terms", "en") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="TripleTalk Terms of Service and Polish terms for the TripleTalk mobile application."
    />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tripletalk.app/terms/" />
    <meta property="og:title" content="Terms of Service - TripleTalk" />
    <meta property="og:description" content="Terms of Service for the TripleTalk mobile application." />
    <meta property="og:image" content="https://tripletalk.app/assets/tripletalk-logo-with-background.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Terms of Service - TripleTalk" />
    <meta name="twitter:description" content="Terms of Service for the TripleTalk mobile application." />
    <meta name="twitter:image" content="https://tripletalk.app/assets/tripletalk-logo-with-background.png" />
    <title>Terms of Service - TripleTalk</title>
    <link rel="canonical" href="https://tripletalk.app/terms/" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/tripletalk-logo.png" />
  </head>
  <body>
    <SiteHeader currentPage="terms" />
    <main class="legal-page legal-page--terms">
      <div class="container legal-shell">
        <div class="legal-documents">
          {
            documents.map(({ language, document }) => (
              <MarkdownDocument document={document} language={language} id={language} hidden={language !== "en"} />
            ))
          }
        </div>
      </div>
    </main>
    <SiteFooter currentPage="terms" />
    <script>
      import { getVisitorLanguage } from "../scripts/visitor-language";

      const translations = {
        pl: {
          navFeatures: "Funkcje",
          navDownload: "Pobierz",
          navTerms: "Regulamin",
          navPrivacy: "Prywatność",
          footerPrivacy: "Polityka Prywatności",
          footerTerms: "Regulamin",
          footerSupport: "Pomoc",
          pageTitle: "Regulamin - TripleTalk",
        },
        en: {
          navFeatures: "Features",
          navDownload: "Download",
          navTerms: "Terms",
          navPrivacy: "Privacy",
          footerPrivacy: "Privacy Policy",
          footerTerms: "Terms of Service",
          footerSupport: "Support",
          pageTitle: "Terms of Service - TripleTalk",
        },
      };

      const menuToggle = document.querySelector(".menu-toggle");
      const navLinks = document.querySelector(".nav-links");
      const translatedNodes = document.querySelectorAll("[data-i18n]");
      const legalDocuments = document.querySelectorAll<HTMLElement>(".legal-document");

      function setLegalLanguage(language: "pl" | "en") {
        document.documentElement.lang = language;
        document.title = translations[language].pageTitle;

        translatedNodes.forEach((node) => {
          const key = node.getAttribute("data-i18n");
          if (key && key in translations[language]) {
            node.textContent = translations[language][key as keyof (typeof translations)["pl"]];
          }
        });

        legalDocuments.forEach((document: HTMLElement) => {
          document.hidden = document.id !== language;
        });
      }

      menuToggle?.addEventListener("click", () => {
        const expanded = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!expanded));
        navLinks?.classList.toggle("open", !expanded);
      });

      navLinks?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuToggle?.setAttribute("aria-expanded", "false");
          navLinks.classList.remove("open");
        });
      });

      setLegalLanguage(await getVisitorLanguage());
    </script>
  </body>
</html>
